---
import Icon from "./Icon.astro"
---

<dialog
  data-command-menu
  aria-label="Search documentation"
  class="fixed inset-x-0 top-[15%] mx-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border-none bg-popover p-2 pb-11 text-popover-foreground shadow-2xl ring-4 ring-border/60 backdrop:bg-black/50"
>
  <div class="flex h-9 items-center gap-2 rounded-md border border-input bg-input/20 px-3">
    <Icon name="search" class="size-4 shrink-0 text-muted-foreground" />
    <input
      data-command-input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="command-list"
      aria-autocomplete="list"
      aria-label="Search documentation"
      placeholder="Search documentation..."
      autocomplete="off"
      spellcheck="false"
      class="h-full min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
    />
  </div>
  <div id="command-list" role="listbox" aria-label="Results" data-command-list class="no-scrollbar mt-1 max-h-[60svh] min-h-80 scroll-pt-8 overflow-y-auto">
  </div>
  <div class="absolute inset-x-0 bottom-0 z-20 flex h-10 items-center gap-4 rounded-b-xl border-t border-border bg-muted/60 px-4 text-xs font-medium text-muted-foreground">
    <span class="flex items-center gap-2">
      <kbd class="flex h-5 items-center rounded border border-border bg-background px-1 font-sans text-[0.7rem]"><Icon name="corner-down-left" class="size-3" /></kbd>
      Go to page
    </span>
    <span class="flex items-center gap-2">
      <kbd class="flex h-5 items-center rounded border border-border bg-background px-1 font-sans text-[0.7rem]">↑↓</kbd>
      Navigate
    </span>
    <span class="ml-auto flex items-center gap-2">
      <kbd class="flex h-5 items-center rounded border border-border bg-background px-1 font-sans text-[0.7rem]">Esc</kbd>
      Close
    </span>
  </div>
</dialog>
