---
/**
 * Themes: a live showcase of the Tecton theme — mode and radius controls, the semantic
 * colours, real components in the current mode and side by side in light and dark, the
 * palette, and the theme stylesheet to copy.
 */
import { existsSync, readFileSync } from "node:fs"
import { resolve } from "node:path"

import CodeBlock from "../components/mdx/CodeBlock.astro"
import PaletteTable from "../components/mdx/PaletteTable.astro"
import TokenTable from "../components/mdx/TokenTable.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getTheme } from "../lib/theme-css"

const heroSource = import.meta.glob<string>("/src/examples/hero-preview.html", {
  query: "?raw",
  import: "default",
  eager: true,
})["/src/examples/hero-preview.html"]

function readWc(relative: string) {
  const dirs = [resolve(process.cwd(), "node_modules/@tecton/wc"), resolve(process.cwd(), "../../packages/wc")]
  const file = dirs.map((dir) => resolve(dir, relative)).find((path) => existsSync(path))
  return file ? readFileSync(file, "utf8") : ""
}

/** theme.css without its generated-file banner. */
const themeCss = readWc("src/styles/theme.css")
  .replace(/^\/\* GENERATED[^\n]*\n/, "")
  .trim()

const theme = getTheme()
const resolved = (mode: "light" | "dark") =>
  [...theme.themeVars.keys()].map((name) => {
    const value = theme.resolveValue(theme.vars[mode].get(name) ?? theme.themeVars.get(name)!, mode)
    return `  ${name}: ${value};`
  })
const resolvedCss = [
  "/* The --tec-* variables with every Tecton token resolved: a standalone theme. */",
  ':root, .light, [data-theme="light"] {',
  "  color-scheme: light;",
  ...resolved("light"),
  "}",
  "",
  '.dark, [data-theme="dark"] {',
  "  color-scheme: dark;",
  ...resolved("dark"),
  "}",
].join("\n")

// Tecton's radius scale is 2 / 4 / 8 / 12 / 16px: half, one, two, three and four times the base.
const radii = [
  { label: "Tecton (4px)", value: "0.25rem" },
  { label: "0", value: "0rem" },
  { label: "0.375rem", value: "0.375rem" },
  { label: "0.5rem", value: "0.5rem" },
  { label: "0.625rem", value: "0.625rem" },
]

const swatches = [
  "background",
  "foreground",
  "card",
  "primary",
  "primary-foreground",
  "secondary",
  "muted",
  "muted-foreground",
  "accent",
  "destructive",
  "border",
  "ring",
  "success",
  "warning",
  "info",
  "neutral",
  "chart-1",
  "chart-2",
  "chart-3",
  "chart-4",
  "chart-5",
].map((name) => {
  const key = `--tec-${name}`
  const raw = theme.themeVars.get(key) ?? ""
  return {
    name,
    key,
    light: theme.resolveValue(theme.vars.light.get(key) ?? raw, "light"),
    dark: theme.resolveValue(theme.vars.dark.get(key) ?? raw, "dark"),
  }
})

const modes = [
  { mode: "light", title: "Light" },
  { mode: "dark", title: "Dark" },
]
---

<BaseLayout title="Themes" description="The Tecton theme: switch the mode, try a radius scale and copy the --tec-* CSS variables.">
  <div class="docs-container-wrapper flex flex-1 flex-col px-6">
    <div class="docs-container flex flex-1 flex-col gap-10 py-8 md:py-10" data-themes>
      <tec-page-header>
        <tec-page-header-content>
          <tec-page-header-title>Themes</tec-page-header-title>
          <tec-page-header-description>
            The Tecton theme is a set of values for the <code class="font-mono">--tec-*</code> CSS variables. Switch the mode, try a
            different radius scale and copy the CSS.
          </tec-page-header-description>
        </tec-page-header-content>
      </tec-page-header>

      <section aria-label="Theme controls and preview" class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
        <div class="flex min-w-0 flex-col gap-6">
          <div class="flex flex-col gap-2">
            <span id="themes-mode-label" class="text-xs font-medium text-muted-foreground">Mode</span>
            <tec-toggle-group aria-labelledby="themes-mode-label" value="dark" disallow-empty data-mode>
              <tec-toggle-group-item value="dark">Dark</tec-toggle-group-item>
              <tec-toggle-group-item value="light">Light</tec-toggle-group-item>
              <tec-toggle-group-item value="system">System</tec-toggle-group-item>
            </tec-toggle-group>
          </div>
          <div class="flex flex-col gap-2">
            <span id="themes-radius-label" class="text-xs font-medium text-muted-foreground">Radius (<code class="font-mono">--tec-radius</code>)</span>
            <tec-toggle-group aria-labelledby="themes-radius-label" value={radii[0].value} disallow-empty class="flex-wrap" data-radius>
              {radii.map((r) => <tec-toggle-group-item value={r.value}>{r.label}</tec-toggle-group-item>)}
            </tec-toggle-group>
            <p class="text-xs text-muted-foreground">
              Tecton's corners are a scale of the base radius: <code class="font-mono">--tec-radius-sm</code> is half of it,
              <code class="font-mono">-md</code> equal, <code class="font-mono">-lg</code>, <code class="font-mono">-xl</code> and
              <code class="font-mono">-2xl</code> two, three and four times it. The control sets the whole scale.
            </p>
          </div>
          <ul class="grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-2" aria-label="Semantic colours">
            {
              swatches.map((s) => (
                <li class="flex min-w-0 items-center gap-2 rounded-md border border-border bg-card p-2">
                  <tec-color-swatch color={`var(${s.key})`} size="md" shape="rounded" aria-hidden="true"></tec-color-swatch>
                  <div class="flex min-w-0 flex-col leading-tight">
                    <span class="truncate text-xs font-medium">--tec-{s.name}</span>
                    <span class="truncate font-mono text-[0.625rem] text-muted-foreground dark:hidden" title={s.light}>{s.light}</span>
                    <span class="hidden truncate font-mono text-[0.625rem] text-muted-foreground dark:inline" title={s.dark}>{s.dark}</span>
                  </div>
                </li>
              ))
            }
          </ul>
          <tec-alert variant="info" appearance="outline">
            <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
            <tec-alert-title>Both modes are Tecton tokens</tec-alert-title>
            <tec-alert-description>
              Every <code class="font-mono">--tec-*</code> variable references a token of the Tecton CSS export in light and dark; the
              token file switches the value.
            </tec-alert-description>
          </tec-alert>
        </div>
        <div class="flex min-w-0 flex-col gap-6" data-not-typeset>
          {heroSource && <div class="flex justify-center" set:html={heroSource.replace(/<script\b[^>]*type=["']module["'][^>]*>[\s\S]*?<\/script>/gi, "")} />}
          <div class="flex flex-wrap items-center gap-3 rounded-lg border border-border bg-card p-4">
            <tec-button>Primary</tec-button>
            <tec-button variant="secondary">Secondary</tec-button>
            <tec-button variant="outline">Outline</tec-button>
            <tec-button variant="ghost">Ghost</tec-button>
            <tec-button variant="destructive">Destructive</tec-button>
            <tec-badge>Badge</tec-badge>
            <tec-badge variant="warning" appearance="outline">Warning</tec-badge>
            <tec-input placeholder="Input" aria-label="Input" class="w-40"></tec-input>
            <tec-checkbox checked>Checkbox</tec-checkbox>
            <tec-switch checked>Switch</tec-switch>
          </div>
        </div>
      </section>

      <section aria-labelledby="themes-modes" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <h2 id="themes-modes" class="text-lg font-medium">Light and dark</h2>
          <p class="text-sm text-muted-foreground">
            The same components in both modes at once: a <code class="font-mono">light</code> or <code class="font-mono">dark</code> class on any
            element switches everything below it, shadow roots included.
          </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {
            modes.map(({ mode, title }) => (
              <div class:list={[mode, "flex flex-col gap-4 rounded-lg border border-border bg-background p-6 text-foreground"]}>
                <span class="text-sm font-medium">{title}</span>
                <div class="flex flex-wrap items-center gap-2">
                  <tec-button size="sm">Primary</tec-button>
                  <tec-button size="sm" variant="secondary">Secondary</tec-button>
                  <tec-button size="sm" variant="outline">Outline</tec-button>
                  <tec-button size="sm" variant="ghost">Ghost</tec-button>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <tec-badge variant="success" appearance="outline">Producing</tec-badge>
                  <tec-badge variant="warning" appearance="outline">Shut in</tec-badge>
                  <tec-badge variant="info" appearance="outline">Drilling</tec-badge>
                  <tec-badge variant="destructive" appearance="outline">Abandoned</tec-badge>
                </div>
                <tec-tabs value="wells">
                  <tec-tabs-list variant="line" aria-label={`Asset views (${title.toLowerCase()})`}>
                    <tec-tabs-trigger value="wells">Wells</tec-tabs-trigger>
                    <tec-tabs-trigger value="fields">Fields</tec-tabs-trigger>
                    <tec-tabs-trigger value="facilities">Facilities</tec-tabs-trigger>
                  </tec-tabs-list>
                </tec-tabs>
                <tec-field>
                  <tec-field-label>Well name</tec-field-label>
                  <tec-input value="34/10-A-12"></tec-input>
                  <tec-field-description>As registered with the authority.</tec-field-description>
                </tec-field>
                <div class="flex flex-wrap items-center gap-4">
                  <tec-checkbox checked>Include sidetracks</tec-checkbox>
                  <tec-switch>Live data</tec-switch>
                </div>
                <tec-progress value="64" aria-label={`Drilling progress (${title.toLowerCase()})`}></tec-progress>
              </div>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="themes-palette" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
          <h2 id="themes-palette" class="text-lg font-medium">Palette</h2>
          <p class="text-sm text-muted-foreground">
            The Tecton colour ramps that replace Tailwind's stock palette, switching value with the mode. The semantic
            variables above are picks from these ramps.
          </p>
        </div>
        <div class="w-fit max-w-full rounded-lg border border-border bg-card p-4 [&>[data-palette-table]]:my-0">
          <PaletteTable />
        </div>
      </section>

      <section aria-labelledby="themes-css" class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <h2 id="themes-css" class="text-lg font-medium">Theme CSS</h2>
          <tec-copy-button value={themeCss} variant="outline" data-copy-theme>Copy CSS</tec-copy-button>
        </div>
        <p class="text-sm text-muted-foreground">
          <code class="font-mono">theme.css</code> maps every <code class="font-mono">--tec-*</code> variable to a Tecton token; it
          ships in <code class="font-mono">@tecton/wc/tecton.css</code> with the tokens it reads. The resolved version has the token
          values inlined and stands alone. A radius other than Tecton's is appended to the copied CSS.
        </p>
        <tec-tabs value="css" class="gap-3">
          <tec-tabs-list variant="line" aria-label="Theme CSS">
            <tec-tabs-trigger value="css">theme.css</tec-tabs-trigger>
            <tec-tabs-trigger value="resolved">resolved values</tec-tabs-trigger>
            <tec-tabs-trigger value="table">mapping</tec-tabs-trigger>
          </tec-tabs-list>
          <tec-tabs-content value="css" class="min-w-0 [&_pre]:max-h-[32rem]">
            <CodeBlock code={themeCss} lang="css" title="@tecton/wc/styles/theme.css" />
          </tec-tabs-content>
          <tec-tabs-content value="resolved" class="min-w-0 [&_pre]:max-h-[32rem]">
            <CodeBlock code={resolvedCss} lang="css" title="tecton-theme.css" />
          </tec-tabs-content>
          <tec-tabs-content value="table" class="min-w-0">
            <TokenTable />
          </tec-tabs-content>
        </tec-tabs>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const THEME_KEY = "tecton-docs:theme"
  const root = document.querySelector<HTMLElement>("[data-themes]")!
  const modeGroup = root.querySelector<HTMLElement & { value: string }>("[data-mode]")!
  const radiusGroup = root.querySelector<HTMLElement & { value: string }>("[data-radius]")!
  const copy = root.querySelector<HTMLElement & { value: string }>("[data-copy-theme]")!
  const baseCss = copy.value
  const html = document.documentElement
  const systemLight = matchMedia("(prefers-color-scheme: light)")

  const stored = () => {
    try {
      return localStorage.getItem(THEME_KEY)
    } catch {
      return null
    }
  }

  const applyMode = (mode: string) => {
    try {
      localStorage.setItem(THEME_KEY, mode)
    } catch {}
    const dark = mode === "system" ? !systemLight.matches : mode === "dark"
    html.classList.toggle("dark", dark)
  }

  // Reflect the stored mode, and follow the header toggle (it switches the class on <html>).
  const syncMode = () => {
    const mode = stored()
    modeGroup.value = mode === "system" ? "system" : html.classList.contains("dark") ? "dark" : "light"
  }
  syncMode()
  new MutationObserver(syncMode).observe(html, { attributes: true, attributeFilter: ["class"] })
  systemLight.addEventListener("change", () => {
    if (stored() === "system") applyMode("system")
  })
  modeGroup.addEventListener("tec-value-change", (event) => {
    applyMode((event as CustomEvent<{ value: string }>).detail.value)
  })

  // The radius scale: sm = r/2, md = r, lg = 2r, xl = 3r, 2xl = 4r (Tecton: 2/4/8/12/16px at 4px).
  const scale: [string, number][] = [
    ["--tec-radius", 1],
    ["--tec-radius-sm", 0.5],
    ["--tec-radius-md", 1],
    ["--tec-radius-lg", 2],
    ["--tec-radius-xl", 3],
    ["--tec-radius-2xl", 4],
  ]
  const tectonRadius = radiusGroup.value
  radiusGroup.addEventListener("tec-value-change", (event) => {
    const radius = (event as CustomEvent<{ value: string }>).detail.value
    const custom = radius !== tectonRadius
    for (const [name, factor] of scale) {
      if (custom) html.style.setProperty(name, `calc(${radius} * ${factor})`)
      else html.style.removeProperty(name)
    }
    copy.value = custom
      ? `${baseCss}\n\n:root {\n${scale.map(([name, factor]) => `  ${name}: calc(${radius} * ${factor});`).join("\n")}\n}\n`
      : baseCss
  })
</script>

<script>
  import "../examples/hero-preview.html?example-script"
</script>
