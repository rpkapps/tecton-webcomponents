{
  "name": "@tecton/wc",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build-theme.mjs && node scripts/build-index.mjs && rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && pnpm run analyze",
    "build:index": "node scripts/build-index.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "analyze": "cem analyze --config custom-elements-manifest.config.mjs",
    "dev": "node scripts/build-index.mjs && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "node scripts/build-index.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/build-index.mjs && tsc --noEmit -p .",
    "check": "node scripts/build-theme.mjs --check && node scripts/build-index.mjs --check"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lit/context": "^1.1.6",
    "@tanstack/table-core": "^9.2.4",
    "lit": "^3.3.3",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.13.0",
    "playwright": "1.63.0",
    "typescript": "^6",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "customElements": "custom-elements.json",
  "description": "Tecton design system web components (Lit).",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tecton.css": "./dist/styles/tecton.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./fonts.css": "./dist/fonts.css",
    "./utilities.css": "./dist/utilities/utilities.css",
    "./tailwind-utilities.css": "./dist/utilities/tailwind-utilities.css",
    "./styles/*": "./dist/styles/*",
    "./custom-elements.json": "./custom-elements.json",
    "./icons": {
      "source": "./src/icons/index.ts",
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./internal/*": null,
    "./package.json": "./package.json",
    "./*.js": {
      "source": "./src/components/*.ts",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./*": {
      "source": "./src/components/*/define.ts",
      "types": "./dist/components/*/define.d.ts",
      "default": "./dist/components/*/define.js"
    }
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/define.js",
    "*.css"
  ]
}
